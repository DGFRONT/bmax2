# Domain the mini app is served on. Its DNS A record must point to the
# server's public IP (78.110.151.227). Enter https://max.rsocit.ru/ as the
# mini app URL in the MAX bot settings.
DOMAIN=max.rsocit.ru
# E-mail for Let's Encrypt certificate notices.
ACME_EMAIL=

# Token of the MAX bot the mini app is attached to (validates initData).
BOT_TOKEN=

# Answer the bot chat with a welcome message and mini app buttons.
# Set to false if another service handles the bot's updates (webhook).
BOT_POLLING=true

# Enables the admin API (/api/admin/*). Leave empty to disable it.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Maximum age of initData signed by MAX.
INIT_DATA_TTL=1h

# debug | info | warn | error
LOG_LEVEL=info
